# ---------------------------------------------------------------------------
# Locarent — variables d'environnement
# Copier en `.env` puis adapter. `.env` n'est jamais versionné.
# ---------------------------------------------------------------------------

# Base de données (docker compose : localhost:55432)
DATABASE_URL="postgresql://locarent:locarent_dev@localhost:55432/locarent?schema=public"

# URL publique de l'application (liens d'invitation, redirections)
APP_URL="http://localhost:3210"

# Secret de signature des cookies / tokens à usage unique (32 octets min.)
# Générer : openssl rand -base64 48
AUTH_SECRET="remplacer-par-un-secret-de-48-octets"

# Stockage S3 (MinIO en local). Aucun upload au Lot 0.
S3_ENDPOINT="http://localhost:59000"
S3_REGION="us-east-1"
S3_BUCKET="locarent-dev"
S3_ACCESS_KEY="locarent"
S3_SECRET_KEY="locarent_dev_secret"
S3_FORCE_PATH_STYLE="true"

# Emails (Mailpit en local)
SMTP_HOST="localhost"
SMTP_PORT="58125"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Locarent <no-reply@locarent.test>"

# Fuseau et devise (rappel : ne pas mettre de défaut implicite dans le code)
APP_TIMEZONE="Pacific/Tahiti"
APP_CURRENCY="XPF"
