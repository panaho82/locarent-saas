// =============================================================================
//  Locarent — schéma Prisma
//
//  Dérivé de docs/schema.sql (39 tables) + table `sessions` (auth web).
//  Conventions :
//    · TS en camelCase, base en snake_case (@@map / @map) ;
//    · identifiants Int (SERIAL) et montants XPF en Int — voir docs/lot-0.md ;
//    · taux et quantités en Decimal (NUMERIC) ;
//    · listes fermées = enum natif Postgres (remplace les CHECK (x IN (...))).
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
//  ÉNUMÉRATIONS (remplacent les CHECK du schéma de référence)
// -----------------------------------------------------------------------------

enum Role {
  owner
  admin
  member

  @@map("user_role")
}

enum SubscriptionStatus {
  trial
  active
  past_due
  cancelled
  expired

  @@map("subscription_status")
}

enum BillingPeriod {
  monthly
  yearly

  @@map("billing_period")
}

enum PayzenMode {
  TEST
  PROD

  @@map("payzen_mode")
}

enum DevicePlatform {
  android
  ios

  @@map("device_platform")
}

enum PriceType {
  per_day
  per_rental

  @@map("price_type")
}

enum FuelType {
  petrol
  diesel
  electric
  hybrid
  lpg

  @@map("fuel_type")
}

enum TransmissionType {
  manual
  automatic

  @@map("transmission_type")
}

enum VehicleStatus {
  available
  rented
  maintenance
  inactive

  @@map("vehicle_status")
}

enum DttAlertState {
  ok
  due_soon
  overdue

  @@map("dtt_alert_state")
}

enum DamageType {
  scratch
  dent
  crack
  missing
  other

  @@map("damage_type")
}

enum DamageSeverity {
  minor
  moderate
  major

  @@map("damage_severity")
}

enum MaintenanceType {
  service
  repair
  tires
  technical_control
  bodywork
  other

  @@map("maintenance_type")
}

enum MaintenanceStatus {
  planned
  in_progress
  done
  cancelled

  @@map("maintenance_status")
}

enum CustomerType {
  private
  company

  @@map("customer_type")
}

enum CustomerSource {
  admin
  online
  phone
  import

  @@map("customer_source")
}

enum DocumentType {
  license_front
  license_back
  id_front
  id_back
  passport
  contract
  other

  @@map("document_type")
}

enum BookingStatus {
  pending
  confirmed
  in_progress
  completed
  cancelled
  declined
  expired

  @@map("booking_status")
}

enum BookingSource {
  admin
  online
  phone
  embed

  @@map("booking_source")
}

enum DurationUnit {
  days
  weeks
  months

  @@map("duration_unit")
}

enum InspectionType {
  departure
  return

  @@map("inspection_type")
}

enum Cleanliness {
  clean
  dirty
  very_dirty

  @@map("cleanliness")
}

enum InvoiceStatus {
  draft
  sent
  paid
  partial
  overdue
  cancelled

  @@map("invoice_status")
}

enum EstimateStatus {
  draft
  sent
  accepted
  declined
  expired
  converted

  @@map("estimate_status")
}

enum PaymentMethod {
  cash
  card
  transfer
  check
  payzen
  other

  @@map("payment_method")
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded

  @@map("payment_status")
}

enum DiscountType {
  amount
  percent

  @@map("discount_type")
}

// -----------------------------------------------------------------------------
//  ABONNEMENTS
// -----------------------------------------------------------------------------

model Plan {
  id           Int    @id @default(autoincrement())
  name         String @db.VarChar(60)
  slug         String @unique @db.VarChar(60)
  monthlyPrice Int    @default(0) @map("monthly_price")
  yearlyPrice  Int    @default(0) @map("yearly_price")

  /// NULL = illimité
  maxVehicles  Int? @map("max_vehicles")
  maxLocations Int? @map("max_locations")

  hasExtraServices      Boolean @default(false) @map("has_extra_services")
  hasMaintenance        Boolean @default(false) @map("has_maintenance")
  hasAdvancedReports    Boolean @default(false) @map("has_advanced_reports")
  hasTvaReport          Boolean @default(false) @map("has_tva_report")
  hasAdvancedPricing    Boolean @default(false) @map("has_advanced_pricing")
  hasFullDashboard      Boolean @default(false) @map("has_full_dashboard")
  hasRentalContracts    Boolean @default(false) @map("has_rental_contracts")
  hasVehicleInspections Boolean @default(false) @map("has_vehicle_inspections")
  hasOnlineBooking      Boolean @default(false) @map("has_online_booking")

  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions Subscription[]

  @@map("plans")
}

// -----------------------------------------------------------------------------
//  AGENCES (tenants) & UTILISATEURS
// -----------------------------------------------------------------------------

model Tenant {
  id           Int     @id @default(autoincrement())
  /// ex. raiatea-rent-car-CYcUmp — suffixe aléatoire contre l'énumération
  slug         String  @unique @db.VarChar(80)
  name         String  @db.VarChar(160)
  managerName  String? @map("manager_name") @db.VarChar(160)
  email        String  @db.VarChar(190)
  phone        String? @db.VarChar(40)
  /// n° TAHITI (identifiant fiscal local)
  tahitiNumber String? @map("tahiti_number") @db.VarChar(40)
  address      String? @db.VarChar(255)
  city         String? @db.VarChar(120)
  zipcode      String? @db.VarChar(20)
  country      String  @default("PF") @db.Char(2)
  island       String? @db.VarChar(80)
  logoPath     String? @map("logo_path") @db.VarChar(255)
  timezone     String  @default("Pacific/Tahiti") @db.VarChar(60)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions    Subscription[]
  users            User[]
  settings         Settings?
  vehicleCategories VehicleCategory[]
  locations        Location[]
  extraServices    ExtraService[]
  vehicles         Vehicle[]
  maintenance      Maintenance[]
  customers        Customer[]
  drivers          Driver[]
  companies        Company[]
  documents        Document[]
  bookings         Booking[]
  inspections      Inspection[]
  invoices         Invoice[]
  estimates        Estimate[]
  payments         Payment[]
  expenses         Expense[]
  promoCodes       PromoCode[]
  notifications    Notification[]
  activityLogs     ActivityLog[]
  sessions         Session[]
  invitations      Invitation[]
  mobileDevices    MobileDevice[]

  @@map("tenants")
}

model Subscription {
  id            Int               @id @default(autoincrement())
  tenantId      Int               @map("tenant_id")
  planId        Int               @map("plan_id")
  status        SubscriptionStatus @default(trial)
  billingPeriod BillingPeriod     @default(monthly) @map("billing_period")
  paymentMethod String            @default("payzen") @map("payment_method") @db.VarChar(20)
  currentPrice  Int               @default(0) @map("current_price")

  trialStartDate     DateTime? @map("trial_start_date") @db.Timestamptz(6)
  trialEndDate       DateTime? @map("trial_end_date") @db.Timestamptz(6)
  currentPeriodStart DateTime? @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime? @map("current_period_end") @db.Timestamptz(6)
  nextRenewalDate    DateTime? @map("next_renewal_date") @db.Timestamptz(6)

  cancelAtPeriodEnd Boolean   @default(false) @map("cancel_at_period_end")
  cancelsAt         DateTime? @map("cancels_at") @db.Timestamptz(6)
  /// identifiant d'abonnement chez le PSP (PayZen)
  externalRef       String?   @map("external_ref") @db.VarChar(120)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@map("subscriptions")
}

model User {
  id     Int    @id @default(autoincrement())
  tenantId Int  @map("tenant_id")
  name   String @db.VarChar(160)
  email  String @db.VarChar(190)

  /// Argon2id
  password      String  @db.VarChar(255)
  role          Role    @default(member)
  /// Tableau JSON de permissions granulaires (union typée côté code)
  permissions   Json    @default("[]")
  isFounder     Boolean @default(false) @map("is_founder")
  isDeactivated Boolean @default(false) @map("is_deactivated")
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz(6)
  rememberToken String? @map("remember_token") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitationsSent Invitation[]     @relation("InvitationInvitedBy")
  mobileDevices   MobileDevice[]
  qrTokens        QrToken[]
  sessions        Session[]
  bookingsCreated Booking[]        @relation("BookingCreatedBy")
  inspectionsDone Inspection[]     @relation("InspectionCompletedBy")
  paymentsMade    Payment[]        @relation("PaymentRecordedBy")
  notifications   Notification[]
  activityLogs    ActivityLog[]

  @@unique([tenantId, email])
  @@map("users")
}

model Invitation {
  id          Int    @id @default(autoincrement())
  tenantId    Int    @map("tenant_id")
  email       String @db.VarChar(190)
  role        Role   @default(member)
  permissions Json   @default("[]")
  token       String @unique @db.VarChar(80)
  invitedBy   Int?   @map("invited_by")
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inviter User? @relation("InvitationInvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@index([tenantId, email])
  @@map("invitations")
}

/// Tokens d'appareil (mobile). Polymorphe dans le schéma d'origine : ici sans
/// relation, utilisé au Lot 7 par l'app mobile + l'échange de QR.
model PersonalAccessToken {
  id             Int    @id @default(autoincrement())
  tokenableType  String @map("tokenable_type") @db.VarChar(60)
  tokenableId    Int    @map("tokenable_id")
  name           String @db.VarChar(120)
  /// sha256 du token en clair
  token          String @unique @db.VarChar(64)
  abilities      Json   @default("[]")
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tokenableType, tokenableId])
  @@map("personal_access_tokens")
}

model MobileDevice {
  id         Int            @id @default(autoincrement())
  tenantId   Int            @map("tenant_id")
  userId     Int            @map("user_id")
  name       String?        @db.VarChar(120)
  model      String?        @db.VarChar(120)
  platform   DevicePlatform
  pushToken  String?        @map("push_token") @db.VarChar(255)
  hasPush    Boolean        @default(false) @map("has_push")
  lastSeenAt DateTime?      @map("last_seen_at") @db.Timestamptz(6)
  /// +90 jours
  expiresAt  DateTime       @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime?      @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mobile_devices")
}

/// Token affiché en QR dans le back-office (30 s, usage unique).
model QrToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  /// 48 caractères aléatoires
  token     String    @unique @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("qr_tokens")
}

/// Session web / mobile. Table ajoutée au Lot 0 (absente du schéma d'origine,
/// qui ne connaissait que des tokens d'API Sanctum).
model Session {
  id         Int      @id @default(autoincrement())
  tenantId   Int      @map("tenant_id")
  userId     Int      @map("user_id")
  /// SHA-256 du token de session : une fuite de base ne donne pas de session
  tokenHash  String   @unique @map("token_hash") @db.VarChar(64)
  ip         String?  @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// -----------------------------------------------------------------------------
//  RÉGLAGES (1 ligne par agence)
// -----------------------------------------------------------------------------

model Settings {
  id       Int @id @default(autoincrement())
  tenantId Int @unique @map("tenant_id")

  companyTagline String? @map("company_tagline") @db.VarChar(160)
  primaryColor   String  @default("#2563eb") @map("primary_color") @db.VarChar(9)

  // Facturation
  invoicePrefix            String  @default("FACT-") @map("invoice_prefix") @db.VarChar(20)
  lastInvoiceSequence      Int     @default(0) @map("last_invoice_sequence")
  nextInvoiceNumber        Int     @default(1) @map("next_invoice_number")
  invoiceDueDays           Int     @default(30) @map("invoice_due_days")
  invoiceDatePrefix        Boolean @default(false) @map("invoice_date_prefix")
  invoiceShowEurEquivalent Boolean @default(false) @map("invoice_show_eur_equivalent")
  invoiceDefaultTerms      String? @map("invoice_default_terms")
  invoiceFooterText        String? @map("invoice_footer_text")

  // Devis
  estimatePrefix            String  @default("DEVIS-") @map("estimate_prefix") @db.VarChar(20)
  lastEstimateSequence      Int     @default(0) @map("last_estimate_sequence")
  estimateDueDays           Int     @default(30) @map("estimate_due_days")
  estimateDatePrefix        Boolean @default(false) @map("estimate_date_prefix")
  estimateShowEurEquivalent Boolean @default(false) @map("estimate_show_eur_equivalent")
  estimateDefaultTerms      String? @map("estimate_default_terms")

  /// CGV en HTML riche (éditeur du Lot 3)
  contractConditions String? @map("contract_conditions")

  // Emails / réservations
  sendBookingConfirmations     Boolean @default(true) @map("send_booking_confirmations")
  sendMailWhenUpdatingBooking  Boolean @default(true) @map("send_mail_when_updating_booking")
  sendInvoiceNotifications     Boolean @default(true) @map("send_invoice_notifications")
  requireManualConfirmation    Boolean @default(true) @map("require_manual_confirmation")
  autoDeclineHours             Int     @default(24) @map("auto_decline_hours")

  // Réservation en ligne
  onlineBookingEnabled             Boolean @default(false) @map("online_booking_enabled")
  onlineBookingAllowOfflinePayment Boolean @default(false) @map("online_booking_allow_offline_payment")
  onlineBookingAllowOnlinePayment  Boolean @default(false) @map("online_booking_allow_online_payment")
  onlineBookingAutoDeclineEnabled  Boolean @default(true) @map("online_booking_auto_decline_enabled")
  onlineBookingAutoDeclineHours    Int     @default(48) @map("online_booking_auto_decline_hours")
  onlineBookingMinLeadHours        Int     @default(2) @map("online_booking_min_lead_hours")
  onlineBookingTurnaroundHours     Int     @default(1) @map("online_booking_turnaround_hours")
  onlineBookingPrimaryColor        String  @default("#FFA633") @map("online_booking_primary_color") @db.VarChar(9)

  // Paiement
  enableOfflinePayments Boolean  @default(false) @map("enable_offline_payments")
  payzenSiteId          String?  @map("payzen_site_id") @db.VarChar(60)
  payzenPublicKey       String?  @map("payzen_public_key") @db.VarChar(255)
  payzenMode            PayzenMode @default(TEST) @map("payzen_mode")
  payzenRestEndpoint    String?  @map("payzen_rest_endpoint") @db.VarChar(255)
  payzenEnabledForEmail Boolean  @default(false) @map("payzen_enabled_for_email")
  /// Chiffrés au repos — jamais renvoyés au client
  payzenRestKeyEnc      String?  @map("payzen_rest_key_enc")
  payzenHmacKeyEnc      String?  @map("payzen_hmac_key_enc")

  // Fiscalité
  defaultCurrency  String  @default("XPF") @map("default_currency") @db.Char(3)
  defaultTaxRate   Decimal @default(13.00) @map("default_tax_rate") @db.Decimal(5, 2)
  tvaEnabled       Boolean @default(false) @map("tva_enabled")
  rentalToleranceHours Int @default(0) @map("rental_tolerance_hours")

  // Flotte
  dttAlertsEnabled       Boolean @default(true) @map("dtt_alerts_enabled")
  dttAlertLeadDays       Int     @default(30) @map("dtt_alert_lead_days")
  mileageAlertsEnabled   Boolean @default(false) @map("mileage_alerts_enabled")
  mileageAlertIntervalKm Int?    @map("mileage_alert_interval_km")

  onboardingCompleted Boolean @default(false) @map("onboarding_completed")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("settings")
}

// -----------------------------------------------------------------------------
//  RÉFÉRENTIELS
// -----------------------------------------------------------------------------

model Brand {
  id        Int     @id @default(autoincrement())
  name      String  @unique @db.VarChar(80)
  slug      String  @unique @db.VarChar(80)
  logoPath  String? @map("logo_path") @db.VarChar(255)
  isVisible Boolean @default(true) @map("is_visible")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicles Vehicle[]

  @@map("brands")
}

model Color {
  slug      String  @id @db.VarChar(30)
  name      String  @db.VarChar(40)
  hex       String  @db.VarChar(9)
  isVisible Boolean @default(true) @map("is_visible")

  vehicles Vehicle[]

  @@map("colors")
}

model VehicleCategory {
  id          Int     @id @default(autoincrement())
  tenantId    Int     @map("tenant_id")
  name        String  @db.VarChar(80)
  description String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]

  @@map("vehicle_categories")
}

model Location {
  id           Int     @id @default(autoincrement())
  tenantId     Int     @map("tenant_id")
  name         String  @db.VarChar(160)
  address      String? @db.VarChar(255)
  island       String? @db.VarChar(80)
  openingHours String? @map("opening_hours") @db.VarChar(255)
  /// frais de prise en charge
  price        Int?
  isFree       Boolean @default(false) @map("is_free")
  isPublic     Boolean @default(true) @map("is_public")
  isDefault    Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicles       Vehicle[]
  bookingsPickup Booking[] @relation("BookingPickupLocation")
  bookingsDropoff Booking[] @relation("BookingDropoffLocation")

  @@map("locations")
}

model ExtraService {
  id          Int       @id @default(autoincrement())
  tenantId    Int       @map("tenant_id")
  name        String    @db.VarChar(120)
  description String?   @db.VarChar(255)
  price       Int       @default(0)
  priceType   PriceType @default(per_rental) @map("price_type")
  maxQty      Int?      @map("max_qty")
  isActive    Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookingExtras BookingExtra[]

  @@map("extra_services")
}

// -----------------------------------------------------------------------------
//  FLOTTE
// -----------------------------------------------------------------------------

model Vehicle {
  id           Int     @id @default(autoincrement())
  tenantId     Int     @map("tenant_id")
  name         String  @db.VarChar(160)
  licensePlate String  @map("license_plate") @db.VarChar(30)
  make         String? @db.VarChar(80)
  brandId      Int?    @map("brand_id")
  model        String? @db.VarChar(80)
  year         Int?    @db.SmallInt
  /// slug du référentiel colors
  colorSlug    String? @map("color") @db.VarChar(30)
  mileage      Int     @default(0)
  seats        Int?    @db.SmallInt
  fuelType     FuelType? @map("fuel_type")
  transmissionType TransmissionType? @map("transmission_type")
  status       VehicleStatus @default(available)

  nextTechnicalControlDate DateTime? @map("next_technical_control_date") @db.Date
  dttAlertState            DttAlertState @default(ok) @map("dtt_alert_state")
  lastMileageAlertAtKm     Int?      @map("last_mileage_alert_at_km")

  // Tarifs (XPF, entiers)
  dailyRate   Int  @default(0) @map("daily_rate")
  weeklyRate  Int? @map("weekly_rate")
  monthlyRate Int? @map("monthly_rate")
  /// km inclus dans le tarif
  baseKilometers Int? @map("base_kilometers")
  extraKmPrice   Int? @map("extra_km_price")

  isActive       Boolean @default(true) @map("is_active")
  mainLocationId Int?    @map("main_location_id")
  categoryId     Int?    @map("category_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand        Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  color        Color?          @relation(fields: [colorSlug], references: [slug], onDelete: SetNull)
  mainLocation Location?       @relation(fields: [mainLocationId], references: [id], onDelete: SetNull)
  category     VehicleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  images     VehicleImage[]
  damages    VehicleDamage[]
  maintenance Maintenance[]
  bookings   Booking[]
  estimates  Estimate[]

  @@unique([tenantId, licensePlate])
  @@index([tenantId, isActive])
  @@map("vehicles")
}

model VehicleImage {
  id         Int     @id @default(autoincrement())
  vehicleId  Int     @map("vehicle_id")
  path       String  @db.VarChar(255)
  isFeatured Boolean @default(false) @map("is_featured")
  sortOrder  Int     @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_images")
}

/// Dommages permanents du véhicule, reportés sur le schéma de carrosserie.
model VehicleDamage {
  id          Int            @id @default(autoincrement())
  vehicleId   Int            @map("vehicle_id")
  zone        String         @db.VarChar(40)
  type        DamageType     @default(scratch)
  severity    DamageSeverity @default(minor)
  description String?        @db.VarChar(255)
  photoPath   String?        @map("photo_path") @db.VarChar(255)
  reportedAt  DateTime       @default(now()) @map("reported_at") @db.Timestamptz(6)
  repairedAt  DateTime?      @map("repaired_at") @db.Timestamptz(6)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_damages")
}

model Maintenance {
  id             Int               @id @default(autoincrement())
  tenantId       Int               @map("tenant_id")
  vehicleId      Int               @map("vehicle_id")
  type           MaintenanceType   @default(service)
  title          String            @db.VarChar(160)
  description    String?
  cost           Int               @default(0)
  mileage        Int?
  performedAt    DateTime?         @map("performed_at") @db.Date
  nextDueDate    DateTime?         @map("next_due_date") @db.Date
  nextDueMileage Int?              @map("next_due_mileage")
  garage         String?           @db.VarChar(160)
  status         MaintenanceStatus @default(planned)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, performedAt])
  @@map("maintenance")
}

// -----------------------------------------------------------------------------
//  CLIENTS
// -----------------------------------------------------------------------------

model Customer {
  id          Int            @id @default(autoincrement())
  tenantId    Int            @map("tenant_id")
  type        CustomerType   @default(private)
  isInsurance Boolean        @default(false) @map("is_insurance")
  source      CustomerSource @default(admin)
  firstName   String?        @map("first_name") @db.VarChar(80)
  lastName    String?        @map("last_name") @db.VarChar(80)
  contactName String?        @map("contact_name") @db.VarChar(160)
  email       String?        @db.VarChar(190)
  phone       String?        @db.VarChar(40)
  phoneCode   String?        @default("+689") @map("phone_code") @db.VarChar(8)
  address     String?        @db.VarChar(255)
  zipcode     String?        @db.VarChar(20)
  city        String?        @db.VarChar(120)
  country     String?        @default("Polynésie française") @db.VarChar(80)
  notes       String?
  archivedAt  DateTime?      @map("archived_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  drivers   Driver[]
  documents Document[]
  bookings  Booking[]
  invoices  Invoice[]
  estimates Estimate[]

  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@map("customers")
}

model Driver {
  id                Int      @id @default(autoincrement())
  tenantId          Int      @map("tenant_id")
  customerId        Int      @map("customer_id")
  firstName         String   @map("first_name") @db.VarChar(80)
  lastName          String   @map("last_name") @db.VarChar(80)
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  gender            String?  @db.VarChar(10)
  licenseCardNumber String?  @map("license_card_number") @db.VarChar(60)
  licenseIssuedAt   DateTime? @map("license_issued_at") @db.Date
  licenseExpiresAt  DateTime? @map("license_expires_at") @db.Date
  licenseCountry    String?  @map("license_country") @db.VarChar(80)
  isMain            Boolean  @default(false) @map("is_main")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookingDrivers BookingDriver[]

  @@index([customerId])
  @@map("drivers")
}

model Company {
  id          Int     @id @default(autoincrement())
  tenantId    Int     @map("tenant_id")
  name        String  @db.VarChar(160)
  contactName String? @map("contact_name") @db.VarChar(160)
  email       String? @db.VarChar(190)
  phone       String? @db.VarChar(40)
  address     String? @db.VarChar(255)
  zipcode     String? @db.VarChar(20)
  city        String? @db.VarChar(120)
  country     String? @default("Polynésie française") @db.VarChar(80)
  /// identifiant fiscal / n° TAHITI
  taxId       String? @map("tax_id") @db.VarChar(60)
  notes       String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  invoices  Invoice[]
  estimates Estimate[]

  @@map("companies")
}

model Document {
  id         Int          @id @default(autoincrement())
  tenantId   Int          @map("tenant_id")
  customerId Int?         @map("customer_id")
  bookingId  Int?         @map("booking_id")
  type       DocumentType
  path       String       @db.VarChar(255)
  mime       String?      @db.VarChar(80)
  sizeBytes  Int?         @map("size_bytes")
  uploadedAt DateTime     @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([bookingId])
  @@map("documents")
}

// -----------------------------------------------------------------------------
//  RÉSERVATIONS
// -----------------------------------------------------------------------------

model Booking {
  id            Int           @id @default(autoincrement())
  tenantId      Int           @map("tenant_id")
  /// ex. B-2026-00991
  bookingNumber String        @map("booking_number") @db.VarChar(30)
  status        BookingStatus @default(pending)
  source        BookingSource @default(admin)
  createdBy     Int?          @map("created_by")

  customerId            Int     @map("customer_id")
  companyId             Int?    @map("company_id")
  showCompanyOnInvoice  Boolean @default(false) @map("show_company_on_invoice")
  vehicleId             Int     @map("vehicle_id")
  pickupLocationId      Int?    @map("pickup_location_id")
  dropoffLocationId     Int?    @map("dropoff_location_id")

  startDate DateTime @map("start_date") @db.Date
  /// "08:00" — chaîne plutôt que TIME : évite les dates fantômes JS
  startTime String   @default("08:00") @map("start_time") @db.VarChar(5)
  endDate   DateTime @map("end_date") @db.Date
  endTime   String   @default("18:00") @map("end_time") @db.VarChar(5)
  rentalDays Int     @default(1) @map("rental_days")

  baseKilometers     Int?    @map("base_kilometers")
  extraKmPrice       Int?    @map("extra_km_price")
  isUnlimitedKilometers Boolean @default(true) @map("is_unlimited_kilometers")

  // Tarifs figés à la création (l'historique ne bouge plus)
  vehicleDailyRate   Int     @default(0) @map("vehicle_daily_rate")
  vehicleWeeklyRate  Int?    @map("vehicle_weekly_rate")
  vehicleMonthlyRate Int?    @map("vehicle_monthly_rate")
  negotiatedRates    Json?   @map("negotiated_rates")
  durationUnit       DurationUnit @default(days) @map("duration_unit")
  durationValue      Int     @default(1) @map("duration_value")

  vehicleTotal       Int     @default(0) @map("vehicle_total")
  extrasTotal        Int     @default(0) @map("extras_total")
  pickupLocationFee  Int     @default(0) @map("pickup_location_fee")
  dropoffLocationFee Int     @default(0) @map("dropoff_location_fee")
  discounts          Json    @default("[]")
  vehicleTaxRate     Decimal @default(0) @map("vehicle_tax_rate") @db.Decimal(5, 2)
  grandTotal         Int     @default(0) @map("grand_total")
  totalPrice         Int     @default(0) @map("total_price")
  taxRate            Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount          Int     @default(0) @map("tax_amount")
  totalWithTax       Int     @default(0) @map("total_with_tax")

  notes         String?
  internalNotes String? @map("internal_notes")

  checkInToken       String    @unique @default(uuid()) @map("check_in_token") @db.Uuid
  checkInCompletedAt DateTime? @map("check_in_completed_at") @db.Timestamptz(6)
  handedOverAt       DateTime? @map("handed_over_at") @db.Timestamptz(6)
  returnedAt         DateTime? @map("returned_at") @db.Timestamptz(6)
  publicReportToken  String    @unique @default(uuid()) @map("public_report_token") @db.Uuid

  contractSignedAt     DateTime? @map("contract_signed_at") @db.Timestamptz(6)
  contractSignatureIp  String?   @map("contract_signature_ip") @db.VarChar(45)
  contractSignatureName String?  @map("contract_signature_name") @db.VarChar(160)
  contractSignatureUa  String?   @map("contract_signature_ua")
  contractSignatureUrl String?   @map("contract_signature_url") @db.VarChar(255)
  hasSignedContract    Boolean   @default(false) @map("has_signed_contract")

  cautionCollected      Boolean   @default(false) @map("caution_collected")
  cautionAmount         Int?      @map("caution_amount")
  cautionCollectedAt    DateTime? @map("caution_collected_at") @db.Timestamptz(6)
  cautionComments       String?   @map("caution_comments")
  cautionContractNotes  String?   @map("caution_contract_notes")
  cautionReleasedAt     DateTime? @map("caution_released_at") @db.Timestamptz(6)
  cautionRefundAmount   Int?      @map("caution_refund_amount")
  cautionRefundComments String?   @map("caution_refund_comments")

  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String?   @map("cancellation_reason") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByUser  User?      @relation("BookingCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  customer       Customer   @relation(fields: [customerId], references: [id])
  company        Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  vehicle        Vehicle    @relation(fields: [vehicleId], references: [id])
  pickupLocation Location?  @relation("BookingPickupLocation", fields: [pickupLocationId], references: [id], onDelete: SetNull)
  dropoffLocation Location? @relation("BookingDropoffLocation", fields: [dropoffLocationId], references: [id], onDelete: SetNull)

  extras     BookingExtra[]
  drivers    BookingDriver[]
  discountsList BookingDiscount[] @relation("BookingDiscounts")
  inspections Inspection[]
  documents  Document[]
  contracts  Contract[]
  invoices   Invoice[]
  payments   Payment[]
  estimates  Estimate[]

  @@unique([tenantId, bookingNumber])
  @@index([tenantId, startDate, endDate])
  @@index([tenantId, status])
  @@index([vehicleId, startDate, endDate])
  @@index([customerId])
  @@map("bookings")
}

model BookingExtra {
  id             Int       @id @default(autoincrement())
  bookingId      Int       @map("booking_id")
  extraServiceId Int?      @map("extra_service_id")
  /// nom figé au moment de la réservation
  name           String    @db.VarChar(120)
  /// prix figé
  unitPrice      Int       @default(0) @map("unit_price")
  priceType      PriceType @default(per_rental) @map("price_type")
  qty            Int       @default(1)
  total          Int       @default(0)

  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  extraService ExtraService? @relation(fields: [extraServiceId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@map("booking_extras")
}

model BookingDriver {
  id        Int  @id @default(autoincrement())
  bookingId Int  @map("booking_id")
  driverId  Int  @map("driver_id")
  isMain    Boolean @default(false) @map("is_main")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([bookingId, driverId])
  @@map("booking_drivers")
}

model BookingDiscount {
  id        Int          @id @default(autoincrement())
  bookingId Int          @map("booking_id")
  label     String?      @db.VarChar(120)
  type      DiscountType
  value     Decimal      @default(0) @db.Decimal(10, 2)
  amount    Int          @default(0)

  booking Booking @relation("BookingDiscounts", fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_discounts")
}

// ---- États des lieux ---------------------------------------------------------

model Inspection {
  id        Int            @id @default(autoincrement())
  tenantId  Int            @map("tenant_id")
  bookingId Int            @map("booking_id")
  type      InspectionType

  mileage              Int?
  /// 0..100
  fuelLevel            Decimal?          @map("fuel_level") @db.Decimal(5, 2)
  cleanlinessInterior  Cleanliness?      @default(clean) @map("cleanliness_interior")
  cleanlinessExterior  Cleanliness?      @default(clean) @map("cleanliness_exterior")
  notes                String?
  signaturePath        String?           @map("signature_path") @db.VarChar(255)
  customerSignatureName String?          @map("customer_signature_name") @db.VarChar(160)
  completedAt          DateTime?         @map("completed_at") @db.Timestamptz(6)
  completedBy          Int?              @map("completed_by")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking     Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  completedByUser User?         @relation("InspectionCompletedBy", fields: [completedBy], references: [id], onDelete: SetNull)
  photos      InspectionPhoto[]
  damages     InspectionDamage[]

  @@unique([bookingId, type])
  @@map("inspections")
}

model InspectionPhoto {
  id           Int      @id @default(autoincrement())
  inspectionId Int      @map("inspection_id")
  zone         String   @db.VarChar(40)
  path         String   @db.VarChar(255)
  takenAt      DateTime @default(now()) @map("taken_at") @db.Timestamptz(6)

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@map("inspection_photos")
}

model InspectionDamage {
  id           Int            @id @default(autoincrement())
  inspectionId Int            @map("inspection_id")
  zone         String         @db.VarChar(40)
  type         DamageType     @default(scratch)
  severity     DamageSeverity @default(minor)
  description  String?        @db.VarChar(255)
  photoPath    String?        @map("photo_path") @db.VarChar(255)

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@map("inspection_damages")
}

/// PDF du contrat + preuve de signature (hash SHA-256, IP, user-agent).
model Contract {
  id                Int       @id @default(autoincrement())
  bookingId         Int       @map("booking_id")
  version           Int       @default(1)
  pdfPath           String    @map("pdf_path") @db.VarChar(255)
  /// SHA-256 du PDF figé : la preuve en cas de contestation
  pdfHash           String?   @map("pdf_hash") @db.Char(64)
  signedAt          DateTime? @map("signed_at") @db.Timestamptz(6)
  signerName        String?   @map("signer_name") @db.VarChar(160)
  signerIp          String?   @map("signer_ip") @db.VarChar(45)
  signerUserAgent   String?   @map("signer_user_agent")
  signatureImagePath String?  @map("signature_image_path") @db.VarChar(255)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("contracts")
}

// -----------------------------------------------------------------------------
//  FINANCE
// -----------------------------------------------------------------------------

model Invoice {
  id            Int           @id @default(autoincrement())
  tenantId      Int           @map("tenant_id")
  /// FACT-2026-00012
  invoiceNumber String        @map("invoice_number") @db.VarChar(30)
  bookingId     Int?          @map("booking_id")
  customerId    Int?          @map("customer_id")
  companyId     Int?          @map("company_id")
  status        InvoiceStatus @default(draft)

  issuedAt   DateTime? @map("issued_at") @db.Date
  dueAt      DateTime? @map("due_at") @db.Date
  subtotal   Int       @default(0)
  taxRate    Decimal   @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount  Int       @default(0) @map("tax_amount")
  discount   Int       @default(0)
  total      Int       @default(0)
  amountPaid Int       @default(0) @map("amount_paid")
  balance    Int       @default(0)
  notes      String?
  terms      String?
  pdfPath    String?   @map("pdf_path") @db.VarChar(255)
  sentAt     DateTime? @map("sent_at") @db.Timestamptz(6)
  paidAt     DateTime? @map("paid_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  company  Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  lines    InvoiceLine[]
  payments Payment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@map("invoices")
}

model InvoiceLine {
  id        Int     @id @default(autoincrement())
  invoiceId Int     @map("invoice_id")
  label     String  @db.VarChar(255)
  qty       Decimal @default(1) @db.Decimal(10, 2)
  unitPrice Int     @default(0) @map("unit_price")
  taxRate   Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  total     Int     @default(0)
  sortOrder Int     @default(0) @map("sort_order")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_lines")
}

model Estimate {
  id             Int            @id @default(autoincrement())
  tenantId       Int            @map("tenant_id")
  /// DEVIS-2026-00003
  estimateNumber String         @map("estimate_number") @db.VarChar(30)
  customerId     Int?           @map("customer_id")
  companyId      Int?           @map("company_id")
  vehicleId      Int?           @map("vehicle_id")
  status         EstimateStatus @default(draft)

  issuedAt DateTime? @map("issued_at") @db.Date
  dueAt    DateTime? @map("due_at") @db.Date
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  subtotal  Int     @default(0)
  taxRate   Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount Int     @default(0) @map("tax_amount")
  total     Int     @default(0)
  notes     String?
  terms     String?
  pdfPath   String? @map("pdf_path") @db.VarChar(255)

  convertedBookingId Int? @map("converted_booking_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer         Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  company          Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  vehicle          Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  convertedBooking Booking?   @relation(fields: [convertedBookingId], references: [id], onDelete: SetNull)
  lines            EstimateLine[]

  @@unique([tenantId, estimateNumber])
  @@map("estimates")
}

model EstimateLine {
  id         Int     @id @default(autoincrement())
  estimateId Int     @map("estimate_id")
  label      String  @db.VarChar(255)
  qty        Decimal @default(1) @db.Decimal(10, 2)
  unitPrice  Int     @default(0) @map("unit_price")
  taxRate    Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  total      Int     @default(0)
  sortOrder  Int     @default(0) @map("sort_order")

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@map("estimate_lines")
}

model Payment {
  id        Int           @id @default(autoincrement())
  tenantId  Int           @map("tenant_id")
  bookingId Int?          @map("booking_id")
  invoiceId Int?          @map("invoice_id")
  amount    Int
  method    PaymentMethod @default(cash)
  status    PaymentStatus @default(completed)
  paidAt    DateTime      @default(now()) @map("paid_at") @db.Timestamptz(6)
  /// n° de transaction PayZen
  reference String?       @db.VarChar(120)
  notes     String?
  recordedBy Int?         @map("recorded_by")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking    Booking?   @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  invoice    Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  recordedByUser User?  @relation("PaymentRecordedBy", fields: [recordedBy], references: [id], onDelete: SetNull)

  @@index([tenantId, paidAt])
  @@index([bookingId])
  @@map("payments")
}

model Expense {
  id            Int      @id @default(autoincrement())
  tenantId      Int      @map("tenant_id")
  category      String   @default("other") @db.VarChar(60)
  label         String   @db.VarChar(160)
  amount        Int      @default(0)
  taxAmount     Int      @default(0) @map("tax_amount")
  date          DateTime @db.Date
  supplier      String?  @db.VarChar(160)
  paymentMethod String?  @map("payment_method") @db.VarChar(20)
  vehicleId     Int?     @map("vehicle_id")
  attachmentPath String? @map("attachment_path") @db.VarChar(255)
  notes         String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@map("expenses")
}

model PromoCode {
  id        Int          @id @default(autoincrement())
  tenantId  Int          @map("tenant_id")
  code      String       @db.VarChar(40)
  type      DiscountType
  value     Decimal      @db.Decimal(10, 2)
  minAmount Int?         @map("min_amount")
  maxUses   Int?         @map("max_uses")
  usedCount Int          @default(0) @map("used_count")
  startsAt  DateTime?    @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime?    @map("ends_at") @db.Timestamptz(6)
  isActive  Boolean      @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("promo_codes")
}

model Notification {
  id       Int     @id @default(autoincrement())
  tenantId Int     @map("tenant_id")
  userId   Int?    @map("user_id")
  type     String  @db.VarChar(60)
  title    String  @db.VarChar(160)
  message  String?
  data     Json    @default("{}")
  readAt   DateTime? @map("read_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

/// Journal d'audit — absent chez l'éditeur d'origine, indispensable en cas de
/// litige (caution, contrat signé, impersonation).
model ActivityLog {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @map("tenant_id")
  userId      Int?     @map("user_id")
  /// ex. booking.confirmed, invoice.sent
  action      String   @db.VarChar(80)
  subjectType String?  @map("subject_type") @db.VarChar(60)
  subjectId   Int?     @map("subject_id")
  properties  Json     @default("{}")
  ip          String?  @db.VarChar(45)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("activity_log")
}
